# ContainerStack release configuration.
#
# Copy to `.env` (gitignored) and fill in. The Taskfile dotenv-loads it, so
# `task release:zamok` takes no arguments — every value comes from here plus the
# committed VERSION file.
#
# SECRETS: use `av://` references, never literal values. `av env -- <cmd>`
# resolves them at run time so the real value never lands on disk or in an agent's
# context. Non-secret values are written literally and pass through untouched.
# See the `agentvault` skill.

# ── Zamok ────────────────────────────────────────────────────────────────────
# The product created by the Zamok bootstrap. Slug must match the Zamok record.
ZAMOK_PRODUCT_SLUG=containerstack
ZAMOK_BASE_URL=https://zamok.example.com

# API key with write access to the product. Prefer an `av://` reference so the
# literal never lands in this file.
ZAMOK_API_KEY=av://example/zamok-api-key

# stable | beta | nightly — lowercased here, uppercased for zamokctl's --channel.
RELEASE_CHANNEL=stable

# ── Code signing ─────────────────────────────────────────────────────────────
# Must be Developer ID Application — never Apple Development or Apple
# Distribution, or the notary service rejects every Mach-O in the bundle.
RELEASE_DEVELOPER_ID_APPLICATION=Developer ID Application: Aleksandr Beshkenadze (Q8H6GWJ658)

# Optional: skip the `security find-identity` lookup by pinning the SHA1.
RELEASE_SIGNING_IDENTITY_SHA1=2A2950821B52BF1AC289AC2ED60F8740732FCCC6

# ── Notarization ─────────────────────────────────────────────────────────────
# One-time per release Mac:
#   task signing:notary-profile
# AgentVault injects the Apple ID/app-specific password/team ID only while
# notarytool stores this Keychain profile. Releases pass only the profile name
# to zamokctl; no Apple credential enters GitHub Actions or the repository.
RELEASE_NOTARY_PROFILE=ContainerStack

# Alternative App Store Connect API-key mode (instead of the profile above):
# NOTARY_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# NOTARY_KEY_ID=XXXXXXXXXX
# NOTARY_ISSUER=00000000-0000-0000-0000-000000000000

# ── Runtime sidecar ──────────────────────────────────────────────────────────
# Which socktainer build gets staged into the bundle. Pin it at the fork
# checkout rather than letting it default to ~/.local/bin, which is installed by
# prepare-v1-runtime.sh and can lag the pinned revision.
#
# Build it with the provenance stamp, or staging will refuse to sign:
#   BUILD_VERSION="containerstack-v1+<rev12>" BUILD_GIT_COMMIT="<rev40>" \
#   BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)" swift build -c release

# ── Sparkle ──────────────────────────────────────────────────────────────────
# The PUBLIC half of the product's SPARKLE_UPDATE key
# (kid_342fddca-dc68-4b8c-a62c-90c99482492c). Public by design: it is baked into
# every shipped bundle as SUPublicEDKey, so committing it is correct.
SPARKLE_PUBLIC_ED_KEY=AXKOdcw3uW6yZeHmFVkBxc3JdzWVmxGXPQBqerE+bBU=

# ── GitHub Releases ──────────────────────────────────────────────────────────
# `gh auth login` keeps the GitHub credential in Keychain. The release mirror
# uploads the zamokctl-produced DMG and the exact same Markdown passed to Sparkle.
GITHUB_RELEASE_REPOSITORY=bshk-app/ContainerStack

# ── Homebrew cask ────────────────────────────────────────────────────────────
# Nothing to configure here. The cask is generated and pushed by Zamok itself:
# the tap lives in the org's HomebrewTapConfig and the per-product details in
# the product's CaskConfig, and publishing a release regenerates the cask
# server-side. No tap token or cask metadata belongs in this repo.
