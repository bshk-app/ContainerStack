#!/usr/bin/env bash
# Installed by `task hooks:install`, which points core.hooksPath here - git does
# not ship hooks with a clone, so a hook nobody installs enforces nothing.
#
# Two properties this hook has to get right:
#
#   * It lints the bytes the commit will contain. Running the linters against
#     paths on disk passes a staged violation whose fix is still unstaged, and
#     blocks a clean staged commit because of unstaged work. So staged blobs are
#     materialised into a temp tree and linted there.
#   * It runs under /bin/bash, which on macOS is still 3.2: no mapfile, no
#     associative arrays. File lists live in the positional parameters.
#
# Formatting and lint block. The comment gate only warns here: it now flags
# every new comment, so blocking on it would fail a commit that legitimately
# comments new code.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
readonly ROOT
cd "$ROOT"

set --
while IFS= read -r -d '' path; do
    case "$path" in
        Sources/*.swift | Tests/*.swift) set -- "$@" "$path" ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[[ $# -gt 0 ]] || exit 0

snapshot="$(mktemp -d)"
trap 'rm -rf "$snapshot"' EXIT

for path in "$@"; do
    mkdir -p "$snapshot/$(dirname "$path")"
    git show ":$path" >"$snapshot/$path"
done

status=0

if command -v swift >/dev/null 2>&1; then
    # The snapshot lives outside the repository, so the configuration has to be
    # named: without it swift-format falls back to its own defaults (2 spaces,
    # 100 columns) and rejects files that match this repository's policy.
    if ! (cd "$snapshot" && swift format lint --strict --configuration "$ROOT/.swift-format" "$@"); then
        printf 'pre-commit: run `task format`, then stage the result\n' >&2
        status=1
    fi
fi

if command -v swiftlint >/dev/null 2>&1; then
    if ! (cd "$snapshot" && swiftlint lint --quiet --strict --config "$ROOT/.swiftlint.yml" -- "$@"); then
        printf 'pre-commit: the paths above are the staged snapshot, not your working tree\n' >&2
        status=1
    fi
else
    printf 'pre-commit: swiftlint not installed, skipping (brew install swiftlint)\n' >&2
fi

# Working tree rather than the staged snapshot, deliberately: warn-only, and a
# human who staged part of a comment wants to hear about the one they are
# looking at. No MAX_NEW_COMMENT_LINES override: the default (1) already
# reports everything.
COMMENT_BLOCK_WARN_ONLY=1 \
    "$ROOT/scripts/hooks/check-new-comment-blocks.sh" || true

exit "$status"
