build/
DerivedData/

Derived/

ContainerStack.xcodeproj/
ContainerStack.xcworkspace/

.tuist-cache/

# Python bytecode from scripts/
__pycache__/

# Timestamped run dumps from the conformance harnesses.
# Rerun the named script to regenerate the rows.
/apiv2-conformance-*.tsv
/docker-api-coverage-*.tsv

# Vendored spec copy pulled for local probing; scripts/docker-api-coverage.sh fetches its own.
/test-conformance/

# Operator-only. Stay on disk; not part of the public tree.
/agentvault.yaml
/.claude/skills/
/claudedocs/

# Working material, not documentation: icon explorations, research briefs, and
# throwaway API spikes. Kept locally; docs/ carries what is still true.
/Design/
/research-*.md
/spikes/

# Release configuration. Holds av:// references rather than literal secrets, but it is
# per-machine (notary key path, signing identity), so .env.example is what ships.
/.env

# Per-machine notes for agents: the release Mac's signing identity and team.
# Identifiers, not secrets - and still nobody else's business.
/CLAUDE.local.md

# zamokctl packaging output: DMG, manifest.json, extracted release notes.
/out/
